# --- Obligatorio ---

# Token del bot (Developer Portal > Bot > Reset Token). NO lo compartas.
DISCORD_TOKEN=pon_aqui_tu_token

# ID de la aplicacion (Developer Portal > General Information > Application ID)
CLIENT_ID=pon_aqui_el_id_de_la_aplicacion

# --- Recomendado ---

# ID de tu servidor. Si lo rellenas, los comandos se registran al instante solo
# en ese servidor. Si lo dejas vacio, se registran globalmente y Discord puede
# tardar hasta 1 hora en mostrarlos.
GUILD_ID=pon_aqui_el_id_de_tu_servidor

# Registrar los comandos automaticamente cada vez que arranca el bot
DEPLOY_ON_START=true

# --- Solo para hostings gratuitos ---

# Puerto de la pagina de estado. Los hostings lo ponen ellos; en tu ordenador
# se usa el 3000 si no dices otra cosa.
# PORT=3000

# URL publica del bot, para que se pinguee a si mismo y no se duerma. En
# Render, Railway, Koyeb, Fly y Replit se detecta sola: solo hace falta
# rellenarla si el hosting no la publica.
# KEEPALIVE_URL=https://mi-bot.onrender.com

# Cada cuantos minutos se pinguea (por defecto 10; Render duerme a los 15).
# KEEPALIVE_MINUTOS=10

# Canal PRIVADO donde el bot guarda copia de su memoria (paneles, cuentas,
# historial). Imprescindible en hostings gratuitos: ahi el disco se borra en
# cada reinicio. Clic derecho en el canal > Copiar ID.
# RESPALDO_CANAL_ID=pon_aqui_el_id_del_canal_de_respaldo

# Cada cuantas horas se guarda la copia (por defecto 6).
# RESPALDO_HORAS=6

# Donde guardar la memoria del bot. Por defecto data/db.json; cambialo solo si
# tu hosting monta el disco persistente en otra ruta.
# BOT_DB=/data/db.json
